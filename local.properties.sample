## This file must *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the
# header note.
# Path to Android SDK
sdk.dir=

# Location of the MSYS2. This is only used on Windows.
msys2.dir=

## Path to the keystore file
keystore.file=

## Disable release signing for local development builds.
## Remove this flag and configure your own keystore for release builds.
app.disable_signing=true

## Package name
app.id=org.ratogramx.client

## Project name
app.name=Ratogram X

## Link to the app's website. If unavailable, link to the market page could be used.
app.download_url=https://github.com/v0dol4zik/RatogramX/releases

## Public source code URL shown by the client.
app.sources_url=https://github.com/v0dol4zik/RatogramX

## Obtain credentials to access Telegram API:
# https://core.telegram.org/api/obtaining_api_id
telegram.api_id=12345
telegram.api_hash=00000000000000000000000000000000

## Extension module to apply. One of: none, hms
tgx.extension=none
