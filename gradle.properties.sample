# Public build defaults. Copy to gradle.properties and customize locally.
android.enableJetifier=false
android.nonFinalResIds=true
android.nonTransitiveRClass=true
android.useAndroidX=true
android.sync.suppressAgpWarnings=UNSUPPORTED_PROJECT_OPTION_USE,EXTERNAL_NATIVE_BUILD_CONFIGURATION,CANNOT_BUILD_SELECTED_TARGET_ABI
org.gradle.jvmargs=-Xmx8G -Dkotlin.daemon.jvm.options="-Xmx8G" -Dfile.encoding=UTF-8 --enable-native-access=ALL-UNNAMED
org.gradle.parallel=true
org.gradle.tooling.parallel=true
org.gradle.configuration-cache=true
org.gradle.caching=true
org.gradle.isolated-projects=true
